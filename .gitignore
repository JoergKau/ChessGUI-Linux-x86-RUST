.siliconboard/
*.siliconboard

# OS noise
.DS_Store
Thumbs.db

# IDE config
.vscode/
.idea/
*.swp
*.swo

# Coverage / docs build output
coverage/
lcov.info
doc/

# Logs
*.log

# Generated demo / scratch files
/scratch/
/notes.md
