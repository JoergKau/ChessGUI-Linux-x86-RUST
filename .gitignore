# Cargo build artifacts
target/

# Cargo.lock is committed (binary-application best practice); do not add it
# to .gitignore. Library crates ignore it; binaries commit it.

# Local user state for egui / eframe
.siliconboard/
*.siliconboard

# OS noise
.DS_Store
Thumbs.db

# IDE config
.vscode/
.idea/
*.swp
*.swo

# Coverage / docs build output
coverage/
lcov.info
doc/

# Logs
*.log
/logs/

# Generated demo / scratch files
/scratch/
/notes.md

# Build artefacts: the assembled and signed macOS bundle. The distribution
# zip (SiliconBoard-<version>-macos-arm64.zip) is committed to the repository.
/SiliconBoard.app/

# Build artefacts: the Linux release folder and its tarball (package-linux.sh).
/SiliconBoard-*-linux-*/
/SiliconBoard-*-linux-*.tar.gz

# macOS dropped files that appear when the repository is copied from or to a
# Mac; they are never ours.
._*
.DS_Store

# Tournament output (the Engine match writes its PGN here by default)
/tournament/
