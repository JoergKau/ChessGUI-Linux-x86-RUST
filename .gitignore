# Cargo build artifacts
target/

# Cargo.lock is committed (binary-application best practice); do not add it
# to .gitignore. Library crates ignore it; binaries commit it.

# Local user state for egui / eframe
.siliconboard/
*.siliconboard

# OS noise
.DS_Store
Thumbs.db

# IDE config
.vscode/
.idea/
*.swp
*.swo

# Coverage / docs build output
coverage/
lcov.info
doc/

# Logs
*.log
/logs/

# Generated demo / scratch files
/scratch/
/notes.md

# Build artefacts: the assembled and signed macOS bundle. Distribution
# archives (macOS zip, Linux tarball) are GitHub release assets, not tracked
# files.
/SiliconBoard.app/
/SiliconBoard-*-macos-*.zip
/SiliconBoard-*-linux-*/
/SiliconBoard-*-linux-*.tar.gz
._*

# Tournament output (the Engine match writes its PGN here by default)
/tournament/

# Python bytecode (tools/)
__pycache__/
